# انسخ هذا الملف إلى .env وعدّل القيم. ملف .env ما ينرفع على GitHub.

# ---------- عام ----------
NODE_ENV=development
PORT=3000
# مفتاح سري طويل وعشوائي (لازم في التشغيل الفعلي). تقدر تولّده بـ:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# الدولة الافتراضية لما يكتب المستخدم الرقم بدون رمز دولة
DEFAULT_COUNTRY=SA
# مكان قاعدة البيانات (SQLite)
# DB_PATH=./data/kashif.db
# إذا السيرفر خلف بروكسي (Railway, Nginx, Cloudflare) حطه 1 عشان يعرف IP الحقيقي
TRUST_PROXY=0

# ---------- رموز التحقق (OTP) ----------
# console = الرمز يطلع في الطرفية (للتجربة المحلية فقط)
# twilio_verify = رسالة SMS حقيقية عبر Twilio Verify
OTP_PROVIDER=console

# ---------- Twilio (اختياري) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# مطلوب إذا OTP_PROVIDER=twilio_verify
TWILIO_VERIFY_SERVICE_SID=
# true = نعرض شركة الاتصالات ونوع الخط عبر Twilio Lookup (مدفوع لكل طلب، والنتيجة تنحفظ مؤقتاً)
TWILIO_LOOKUP_ENABLED=false

# ---------- الحدود (ضد الجمع الآلي) ----------
SEARCHES_PER_MINUTE=5
SEARCHES_PER_DAY=30
ANON_SEARCHES_PER_DAY=10
REPORTS_PER_DAY=20
OTP_PER_PHONE_PER_15_MIN=3
OTP_PER_IP_PER_HOUR=10
API_REQUESTS_PER_MINUTE=60

# ---------- البلاغات ----------
# أقل عدد بلاغات عشان يظهر العدد للناس (يحمي من بلاغ واحد كيدي). حطه 1 للتجربة.
REPORTS_MIN_TO_SHOW=3
# البلاغات الأقدم من كذا تنحذف تلقائياً
REPORTS_RETENTION_DAYS=365
